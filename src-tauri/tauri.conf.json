{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenQuoteBar",
  "version": "../package.json",
  "identifier": "com.openquotebar.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "OpenQuoteBar",
        "width": 420,
        "height": 560,
        "resizable": true,
        "visible": false
      },
      {
        "label": "popup",
        "title": "OpenQuoteBar",
        "url": "index.html",
        "width": 388,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Daniel Rosa",
    "copyright": "Copyright © 2026 Daniel Rosa",
    "category": "Utility",
    "shortDescription": "Keep your LLM API balances in the menu bar.",
    "longDescription": "OpenQuoteBar keeps the available balance of your LLM API providers in the macOS menu bar or the Windows system tray, refreshing it in the background and always showing the last known value.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
